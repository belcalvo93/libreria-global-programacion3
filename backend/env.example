# Copiar este archivo como .env y completar con los datos reales.
# El archivo .env NO se sube al repositorio.
DATABASE_URL=postgresql+asyncpg://USUARIO:CONTRASENA@localhost:5432/libreria

# Opcional: poné true para ver en la consola las consultas SQL emitidas (evidencia del caso C-07)
SQL_ECHO=false

# Orígenes del navegador que pueden llamar a la API (CORS), separados por coma.
# Orígenes exactos: esquema + host[:puerto], sin barra final y sin comodines.
# Local:     CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# Easypanel: CORS_ORIGINS=https://<dominio-del-front>
# Vacía o ausente = sin CORS (la API arranca igual). Se lee al arrancar: si la
# cambiás, reiniciá la API.
CORS_ORIGINS=

# --- Contenedor (despliegue en el VPS) ---------------------------------------
# El contenedor no lee un .env: recibe estas variables con --env-file, desde un
# archivo que vive en el servidor, fuera del repositorio y de la imagen.
# Dentro del contenedor, localhost es el propio contenedor: si PostgreSQL corre
# en el servidor se usa host.docker.internal (con
# --add-host=host.docker.internal:host-gateway en el docker run), o la dirección
# que entregue la cátedra.
#
# DATABASE_URL=postgresql+asyncpg://USUARIO:CONTRASENA@host.docker.internal:5432/NOMBRE_DE_LA_BASE
# SQL_ECHO=false
