server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # Imágenes (fondo, gato y luna): cache largo en el navegador.
    location /img/ {
        expires 30d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    # Íconos de la pestaña (C-06h, derivados de la luna): cache de una semana,
    # así un cambio de ícono se ve sin renombrar archivos.
    location ~ ^/(favicon\.ico|favicon-32\.png|apple-touch-icon\.png)$ {
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    # Música de fondo (C-06g): mismo cache que las imágenes. nginx responde los
    # pedidos Range (206) de archivos estáticos por defecto; el navegador los usa
    # para el loop y para buscar dentro del audio.
    location /audio/ {
        types { audio/mpeg mp3; }
        expires 30d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass http://${API_UPSTREAM}/;
    }
}
